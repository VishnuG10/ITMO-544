AWS_REGION=us-east-2
AZ_A=us-east-2a
AZ_B=us-east-2b
AMI_ID=ami-xxxxxxxxxxxxxxxxx
INSTANCE_TYPE=t3.micro
KEY_NAME=your-keypair-name
APP_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
WEATHER_ROLE_NAME=itmo-544-weather-role
WEATHER_PROFILE_NAME=itmo-544-weather-profile
WEATHER_LT_NAME=itmo-544-weather-lt
WEATHER_TG_NAME=itmo-544-weather-tg
WEATHER_ASG_NAME=itmo-544-weather-asg
WEATHER_LISTENER_PORT=8080
ADVISOR_ROLE_NAME=itmo-544-advisor-role
ADVISOR_PROFILE_NAME=itmo-544-advisor-profile
ADVISOR_LT_NAME=itmo-544-advisor-lt
ADVISOR_TG_NAME=itmo-544-advisor-tg
ADVISOR_ASG_NAME=itmo-544-advisor-asg
ADVISOR_LISTENER_PORT=8081
ALB_NAME=itmo-544-weather-alb
ALB_SG_NAME=itmo-544-weather-alb-sg
DB_INSTANCE_ID=itmo-544-weather-db
DB_NAME=weather
DB_USER=weatherapp
DB_SG_NAME=itmo-544-weather-db-sg
DB_SUBNET_GROUP_NAME=itmo-544-weather-db-subnets
